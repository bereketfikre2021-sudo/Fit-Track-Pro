# ──────────────────────────────────────────────────────────────────────────────
# VITE_GEMINI_API_KEY is intentionally NOT used.
#
# VITE_ variables are compiled into the JavaScript bundle and are visible to
# anyone who opens browser DevTools — do NOT put your Gemini key here.
#
# Instead: open the app → Profile → Settings → AI Settings and paste your key.
# It is saved only in your browser's localStorage and never touches the network
# or git history.
#
# Get a key at: https://aistudio.google.com/apikey
# ──────────────────────────────────────────────────────────────────────────────

# Model is not a secret — safe to set here.
VITE_GEMINI_MODEL=gemini-3.5-flash

# ──────────────────────────────────────────────────────────────────────────────
# Supabase — create a project at https://supabase.com
# Copy these from: Project Settings → API
# These are safe to expose (public anon keys, protected by RLS).
# ──────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ──────────────────────────────────────────────────────────────────────────────
# Firebase — create a project at https://console.firebase.google.com
# Copy these from: Project Settings → General → Your apps → Web app → SDK config
# These are safe to expose (they are public identifiers, protected by Security Rules).
# ──────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# VAPID key — from: Firebase Console → Cloud Messaging → Web Push certificates
# Generate one if none exists. This is a public key — safe to commit.
VITE_FIREBASE_VAPID_KEY=
# ──────────────────────────────────────────────────────────────────────────────
# Google AdMob — Capacitor Android integration
#
# In development these are ignored (Google's official test ad unit IDs are used).
# Replace the placeholder values below with your real AdMob IDs before releasing
# to the Play Store.
#
# Get IDs from: https://apps.admob.com → Apps → <Your App> → Ad units
#
# VITE_ prefix makes them available at build time. They are public identifiers —
# they are safe to include in the client bundle (the AdMob SDK enforces app
# ownership through Google's servers, not by keeping these IDs secret).
# ──────────────────────────────────────────────────────────────────────────────

# Your AdMob App ID (from Apps → App settings → App ID)
# Format: ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
VITE_ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# Banner ad unit (Home, Progress/History screens)
VITE_ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Interstitial ad unit (shown sparingly, e.g. after workout completion)
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Rewarded ad unit (optional — user-initiated only)
VITE_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Set to "true" to force test ads in any build (default: test ads in dev only)
VITE_ADMOB_FORCE_TEST_ADS=false

# Set to "true" to disable all ads (future premium subscription flag)
VITE_ADMOB_DISABLED=false
